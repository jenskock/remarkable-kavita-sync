# kavita-sync configuration.
# Copy to /home/root/.config/kavita-sync.conf and edit.
# Lines are KEY=VALUE. The file is not executed as a shell script.
# Do not commit a copy that contains a real API key.

# Kavita origin, without a trailing slash. A subpath is allowed if Kavita
# is not hosted at the root (https://example.com/kavita).
SERVER_URL=https://books.jenskock.de

# Kavita → user menu → Settings → 3rd party clients / OPDS.
# The key is the UUID in the OPDS URL. OPDS must be enabled for the user,
# and the user needs permission to download files.
API_KEY=

# Directory Plato reads. Kept under /home so a firmware update does not wipe it.
DEST=/home/root/plato-media

# Folder layout. One of:
#   flat | series | author | author-series | library | library-series | library-author-series
LAYOUT=library-series

# ETag manifest and lock. Also under /home.
STATE_DIR=/home/root/.local/share/kavita-sync

# Delete tracked local files that disappeared from the server. Off by default.
# --delete on the command line does the same for a single run.
DELETE_MISSING=0

# books.jenskock.de sits behind Cloudflare, which often blocks a bare wget UA.
USER_AGENT=Mozilla/5.0 (compatible; kavita-sync/1.0; reMarkable)

# Optional CA bundle if certificate verification fails on the tablet.
# CA_CERT=/etc/ssl/certs/ca-certificates.crt

# Set to 1 only while debugging a certificate problem.
INSECURE=0
